{
  "expo": {
    "name": "BioSecure",
    "slug": "biosecure",
    "scheme": "biosecure",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7EF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": []
  }
}
